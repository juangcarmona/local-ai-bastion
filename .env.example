# =========================
# Host / Ports
# =========================
HOST=0.0.0.0

# =========================
# Python venv (REQUIRED)
# =========================
VENV_DIR=${HOME}/venvs/local-ai-bastion

LITELLM_PORT=4000
CHAT_PORT=8001
CODE_PORT=8002
EMBED_PORT=8003

# =========================
# Paths (no hardcoded /home/juan)
# =========================
# Root where you store HF models + gguf files
MODEL_DIR=${HOME}/models

# GGUF path for GLM chat (quantized)
CHAT_GGUF=${MODEL_DIR}/glm-4.7-flash/GLM-4.7-Flash-Q4_K_M.gguf

# HF model ids (or local dirs under MODEL_DIR)
CODE_MODEL=${MODEL_DIR}/qwen2.5-coder-14b-awq
EMBED_MODEL=${MODEL_DIR}/bge-small-en-v1.5

# Visible model names exposed at the front door (LiteLLM)
CHAT_MODEL_NAME=chat-glm47
CODE_MODEL_NAME=code-qwen25-14b
EMBED_MODEL_NAME=embed-bge-small

# =========================
# Safe defaults (context)
# =========================
CHAT_CTX=8192
CODE_CTX=8192
EMBED_CTX=512

# =========================
# Concurrency & memory shaping (avoid thrash/OOM)
# =========================
# vLLM KV cache / batching
CODE_MAX_NUM_SEQS=6
EMBED_MAX_NUM_SEQS=32

# vLLM GPU utilization cap (fraction of total VRAM)
# Keep headroom for llama.cpp chat model + CUDA overhead.
CODE_GPU_UTIL=0.32
EMBED_GPU_UTIL=0.06

# llama.cpp shaping
CHAT_PARALLEL=2
CHAT_BATCH=512
CHAT_THREADS=12

# =========================
# llama.cpp source/build pin (stability)
# =========================
LLAMA_CPP_DIR=${PWD}/.deps/llama.cpp
LLAMA_CPP_GIT_REF=b4356
LLAMA_CPP_BUILD_DIR=${LLAMA_CPP_DIR}/build
LLAMA_SERVER_BIN=${PWD}/bin/llama-server

# =========================
# Logging
# =========================
LOG_DIR=${PWD}/logs
PID_DIR=${PWD}/.pids

# =========================
# Optional: HF cache location (keeps WSL disk predictable)
# =========================
HF_HOME=${MODEL_DIR}/.hf
TRANSFORMERS_CACHE=${HF_HOME}/transformers
HF_HUB_DISABLE_TELEMETRY=1


# =========================
# Claude Code (client-only)
# =========================
CLAUDE_VENV_DIR=${HOME}/venvs/claude-code

# Claude will talk to LiteLLM router
CLAUDE_OPENAI_BASE_URL=http://localhost:4000/v1
CLAUDE_OPENAI_API_KEY=local-noop
CLAUDE_OPENAI_MODEL=code-qwen25-14b